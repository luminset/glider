# I2P 域名分流规则
# 所有 .i2p 后缀域名通过 HTTP 代理 192.168.155.7:7778 访问

# 上级代理（I2P HTTP 代理）
forward=http://192.168.155.7:7778

# 匹配所有 .i2p 后缀域名（最长后缀匹配，自动覆盖 *.i2p）
domain=i2p

# DNS 查询也经过此上级代理
# DNS 查询将通过 forward 指定的 HTTP 代理隧道到达此 DNS 服务器
# 如果 I2P 路由器提供 DNS 服务，使用其地址；否则可指向任意可达 DNS
dnsserver=192.168.155.7:53

# 健康检查（I2P 代理可能不响应标准 HTTP 检查，禁用）
check=disable
