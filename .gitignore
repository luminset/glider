# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Project-local glide cache, RE: https://github.com/Masterminds/glide/issues/736
.glide/

# custom
.idea
.vscode
.zed
.DS_Store

# local workbench notes (memory, upstream handoff, rendered previews) --
# may contain internal addresses, keep them out of the repository
.workbuddy/

# dev test only
/dev/
.gocache/
dev*.go

*_test.go

dist

*.zip
/*.conf
/*.rule
# 本地规则文件（含本机内网地址），只提交 .example 模板
/rules/*.rule

config/rules.d/*.rule
config/rules.d/*.list

glider
/bak/
/rules.d/

# pacweb 自动导出的 CA 证书（环境相关，不入库）
/ca.crt
/ca.pem

# 本地运行时日志
*.log

# 蓝屏转储（含本机驱动清单/内核地址等环境信息，不入库）
/dump/
*.dmp
